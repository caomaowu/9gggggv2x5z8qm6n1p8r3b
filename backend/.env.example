PROJECT_NAME=QuantAgent
API_V1_STR=/api/v1
MARKET_DATA_API_URL=https://webui.caomaowu.lol
MARKET_DATA_API_TOKEN=api-header-I1iMwyAmXC4H6c58_O9kPjk1BxytE9RQlLgN--SohbY
# OKX instrument type: SWAP (perpetual futures) or SPOT
OKX_INSTRUMENT_TYPE=SWAP
# OKX API version: v5 (transparent proxy) or v1 (legacy direct)
MARKET_DATA_API_VERSION=v5

# ===========================================
# Brale Agent LLM (per-agent override, 可选)
# ===========================================
# 不设置则回退到 AGENT_PROVIDER / AGENT_MODEL / 各 Agent 默认温度

# Indicator Agent (默认温度 0.2)
BRALE_INDICATOR_PROVIDER=
BRALE_INDICATOR_MODEL=
BRALE_INDICATOR_TEMPERATURE=0.2

# Structure Agent (默认温度 0.1, 最低 — 结构判断需更确定)
BRALE_STRUCTURE_PROVIDER=
BRALE_STRUCTURE_MODEL=
BRALE_STRUCTURE_TEMPERATURE=0.1

# Mechanics Agent (默认温度 0.2)
BRALE_MECHANICS_PROVIDER=
BRALE_MECHANICS_MODEL=
BRALE_MECHANICS_TEMPERATURE=0.2

# Optimizer LLM Settings
OPTIMIZER_PROVIDER=openrouter
OPTIMIZER_MODEL=openai/gpt-4o
OPTIMIZER_TEMPERATURE=0.7

# LLM Request Timeout (seconds)
LLM_TIMEOUT=300.0

# ===========================================
# API Keys (per provider)
# ===========================================
MODELSCOPE_API_KEY=your-modelscope-key
DEEPSEEK_API_KEY=your-deepseek-key
IFLOW_API_KEY=your-iflow-key
IFLOW2_API_KEY=your-iflow2-key
OPENROUTER_API_KEY=your-openrouter-key
ARK_API_KEY=your-ark-key
CODEX_API_KEY=your-codex-key
SOUL_API_KEY=your-soul-key
API302_API_KEY=your-302ai-key

# ===========================================
# Agent 评分模式 & Fusion 阈值
# ===========================================
#
# AGENT_SCORE_MODE — 控制 LLM Agent 在不确定时的打分倾向
#   conservative : 证据不足/矛盾时 score=0（保守派，宁可错过不做错）
#   lean         : 证据不足/矛盾时也给出微偏倾向（0.1-0.3），让 Fusion 投票决定
#
AGENT_SCORE_MODE=conservative

# FUSION_SCORE_THRESHOLD — Fusion 共识分数的方向判定门槛 [0, 1]
#   0.35 = 默认（brale 原版）
#   0.25 = 中等
#   0.15 = 激进
#
FUSION_SCORE_THRESHOLD=0.35

# FUSION_CONFIDENCE_THRESHOLD — Fusion 共识置信度的方向判定门槛 [0, 1]
#   0.52 = 默认（brale 原版）
#   0.40 = 中等
#   0.30 = 激进
#
FUSION_CONFIDENCE_THRESHOLD=0.52

# 预设组合参考：
# [保守-高门槛] 只做明确行情 → conservative + 0.35/0.52
# [保守-中门槛] 微弱共识也能触发 → conservative + 0.25/0.40
# [保守-低门槛] 几乎总有信号     → conservative + 0.15/0.30
# [倾向-高门槛] 强共识+倾向信号  → lean + 0.35/0.52
# [倾向-低门槛] 最激进           → lean + 0.15/0.30

# ===========================================
# Default LLM (brale agent fallback)
# ===========================================
AGENT_PROVIDER=modelscope
AGENT_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AGENT_TEMPERATURE=0.1

# ===========================================
# Thinking mode & reasoning effort
# ===========================================
INDICATOR_THINKING_MODE=False
PATTERN_THINKING_MODE=False
TREND_THINKING_MODE=False
DECISION_THINKING_MODE=False
INDICATOR_REASONING_EFFORT=medium
PATTERN_REASONING_EFFORT=medium
TREND_REASONING_EFFORT=medium
DECISION_REASONING_EFFORT=medium
DECISION_AGENT_VERSION=lite
