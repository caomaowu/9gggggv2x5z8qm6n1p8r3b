PROJECT_NAME=QuantAgent
API_V1_STR=/api/v1
MARKET_DATA_API_URL=https://webui.caomaowu.lol
MARKET_DATA_API_TOKEN=api-header-I1iMwyAmXC4H6c58_O9kPjk1BxytE9RQlLgN--SohbY
# OKX instrument type: SWAP (perpetual futures) or SPOT
OKX_INSTRUMENT_TYPE=SWAP

# ===========================================
# LLM Provider Configuration
# ===========================================
# Available providers: modelscope, openai, deepseek, anthropic, custom

# --- Default LLM (fallback for brale agents) ---
# AGENT_PROVIDER=modelscope
# AGENT_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
# AGENT_TEMPERATURE=0.1

# --- Brale Agent LLM (per-agent override, optional) ---
# 不设置则默认使用 AGENT_PROVIDER / AGENT_MODEL / 各自默认温度

# Indicator Agent (默认温度 0.2)
BRALE_INDICATOR_PROVIDER=
BRALE_INDICATOR_MODEL=
BRALE_INDICATOR_TEMPERATURE=0.2

# Structure Agent (默认温度 0.1, 最低 — 结构判断需更确定)
BRALE_STRUCTURE_PROVIDER=
BRALE_STRUCTURE_MODEL=
BRALE_STRUCTURE_TEMPERATURE=0.1

# Mechanics Agent (默认温度 0.2)
BRALE_MECHANICS_PROVIDER=
BRALE_MECHANICS_MODEL=
BRALE_MECHANICS_TEMPERATURE=0.2

# Optimizer LLM Settings
OPTIMIZER_PROVIDER=openrouter
OPTIMIZER_MODEL=openai/gpt-4o
OPTIMIZER_TEMPERATURE=0.7

# LLM Request Timeout (seconds)
LLM_TIMEOUT=300.0

# ===========================================
# API Keys (per provider)
# ===========================================
MODELSCOPE_API_KEY=ms-5b276203-2e1d-4083-b7e8-113630a13a14
OPENAI_API_KEY=sk-your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
IFLOW_API_KEY=your-iflow-api-key
CODEX_API_KEY=your-codex-api-key
SOUL_API_KEY=your-soul-api-key
API302_API_KEY=your-302ai-api-key

# Custom provider settings (if CUSTOM is selected)
CUSTOM_API_BASE=https://your-custom-api.com/v1
CUSTOM_API_KEY=your-custom-api-key
CUSTOM_AGENT_MODEL=your-agent-model
CUSTOM_GRAPH_MODEL=your-graph-model

# Legacy settings (for backward compatibility)
LEGACY_OPENAI_API_KEY=
LEGACY_OPENAI_API_BASE=

# ===========================================
# Deprecated (brale migration — no longer used)
# ===========================================
# GRAPH_PROVIDER / GRAPH_MODEL / GRAPH_TEMPERATURE  — 旧 pattern/trend 视觉 LLM
