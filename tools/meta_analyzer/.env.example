# Meta-Analyzer Configuration

# --- LLM Settings (OpenAI Protocol Compatible) ---
# Supports OpenAI, DeepSeek, iFlow, openrouter, etc.

# The API Key for your provider
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# The Base URL for the API
# Common Examples:
# - OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com/v1
# - iFlow: https://apis.iflow.cn/v1
# - OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1

# The model name to use
# Examples: gpt-4, deepseek-chat, qwen-max, anthropic/claude-3-opus
LLM_MODEL=gpt-3.5-turbo

# Temperature for generation (0.0 - 1.0)
# Lower values are more deterministic and better for analysis
LLM_TEMPERATURE=0.2

# --- Data Settings ---
# Path to the history data directory (JSON files)
# Defaults to ../../backend/data/history if not set
# You can use absolute path or relative path
# DATA_DIR=./my_data
