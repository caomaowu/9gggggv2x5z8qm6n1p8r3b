# 仿真模块环境变量（可选，均有默认值）
# ANALYZE_API_URL=http://localhost:8000/api/v1/analyze/
# MARKET_DATA_API_URL=https://webui.caomaowu.lol
# MARKET_DATA_API_TOKEN=<your-proxy-token>
# SIM_HOST=0.0.0.0
# SIM_PORT=18520
# DB_PATH=./data/simulation.db

# ── K线调度 ──
# KLINE_BUFFER_SECONDS=4
# ── 预分析提前量（K线收盘前N秒启动分析，可按周期单独配置）──
# PRE_ANALYZE_OFFSET_5M=70
# PRE_ANALYZE_OFFSET_15M=70
# PRE_ANALYZE_OFFSET_1H=70
# PRE_ANALYZE_OFFSET_4H=70
# PRE_ANALYZE_OFFSET_1D=70
